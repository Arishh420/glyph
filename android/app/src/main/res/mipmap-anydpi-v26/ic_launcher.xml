<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon, used from Android 8 onward. The launcher masks the two
    layers to whatever shape the device theme wants, so the mark must stay
    inside the inner 66% safe zone; tool/make_icons.dart keeps it there.
    "monochrome" supplies the themed-icon variant on Android 13+.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
